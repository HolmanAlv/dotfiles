#!/bin/sh
# theme <nombre> [--system] : aplica el tema <nombre>. Con --system también el login (LightDM, pide sudo).
# Los temas son la copia local que deja install.sh en ~/.local/share/dotfiles/themes: nada apunta al repo.
set -eu
[ "$(id -u)" != 0 ] || { echo "theme: ejecútalo sin sudo (con --system pide la contraseña él solo)" >&2; exit 1; }
D=$HOME/.local/share/dotfiles/themes
name=${1:-}
T=$D/$name
if [ -z "$name" ] || [ ! -f "$T/theme.env" ]; then
    echo "uso: theme <$(ls "$D" | paste -sd'|')> [--system]" >&2
    exit 1
fi
. "$T/theme.env"
# WALLS (theme.env): un fondo de walls/ por escritorio, en orden; si hay más escritorios se repiten
WALLS=${WALLS:-$(ls "$T/walls" | head -n1)}
WALL=$T/walls/${WALLS%% *}
for w in $WALLS; do
    [ -f "$T/walls/$w" ] || { echo "theme: no existe walls/$w" >&2; exit 1; }
done
# Validar antes de tocar nada: un tema a medias es peor que no cambiar
for d in "$HOME/.themes/$GTK" "$HOME/.local/share/icons/$ICONS" "$HOME/.local/share/icons/$CURSOR"; do
    [ -d "$d" ] || { echo "theme: falta $d (ejecuta install.sh)" >&2; exit 1; }
done

# Las configs enlazadas importan desde aquí (alacritty, rofi, p10k, legcord)
ln -sfn "$T" "$HOME/.config/theme"

# GTK, iconos y cursor: las apps GTK3, el panel y xfwm4 cambian en vivo
xfconf-query -c xsettings -p /Net/ThemeName -s "$GTK"
xfconf-query -c xsettings -p /Net/IconThemeName -s "$ICONS"
xfconf-query -c xsettings -p /Gtk/CursorThemeName -s "$CURSOR"
# Portal/libadwaita/Electron/navegadores leen gsettings
gsettings set org.gnome.desktop.interface gtk-theme "$GTK"
gsettings set org.gnome.desktop.interface icon-theme "$ICONS"
gsettings set org.gnome.desktop.interface cursor-theme "$CURSOR"
gsettings set org.gnome.desktop.interface color-scheme "prefer-$MODE"
mkdir -p "$HOME/.icons/default" "$HOME/.config/gtk-4.0"
printf '[Icon Theme]\nInherits=%s\n' "$CURSOR" > "$HOME/.icons/default/index.theme"
# GTK4 no lee el tema por nombre: se importa su CSS + las reglas cuadradas (apps GTK4 se reinician para verlo)
ln -sfn "$HOME/.themes/$GTK/gtk-4.0/assets" "$HOME/.config/gtk-4.0/assets"
for f in gtk gtk-dark; do
    rm -f "$HOME/.config/gtk-4.0/$f.css"
    printf '@import url("file://%s");\n@import url("file://%s");\n' \
        "$HOME/.themes/$GTK/gtk-4.0/$f.css" "$HOME/.config/gtk-3.0/gtk.css" > "$HOME/.config/gtk-4.0/$f.css"
done

# Fondos en todos los monitores: el escritorio N usa la N-ésima de WALLS. Además de los que ya existen,
# crea los de cada salida de xrandr (conectada o no): el nombre cambia con el driver (eDP1 → eDP-1)
n=$(echo $WALLS | wc -w)
{
    xfconf-query -c xfce4-desktop -l | grep '/last-image$'
    for m in $(xrandr | awk '/connected/ {print $1}'); do
        for ws in $(seq 0 $(($(xfconf-query -c xfwm4 -p /general/workspace_count) - 1))); do
            echo "/backdrop/screen0/monitor$m/workspace$ws/last-image"
        done
    done
} | sort -u | while read -r p; do
    ws=${p##*/workspace}; ws=${ws%%/*}
    xfconf-query -c xfce4-desktop -p "$p" -n -t string -s "$T/walls/$(echo $WALLS | cut -d' ' -f$((ws % n + 1)))"
done

# Plank: un nombre distinto por tema para que dconf dispare el cambio
mkdir -p "$HOME/.local/share/plank/themes"
ln -sfn "$T/plank" "$HOME/.local/share/plank/themes/$name"
dconf write /net/launchpad/plank/docks/dock1/theme "'$name'"

# Apps que reescriben su propia config: solo se cambia una línea
f=$HOME/.config/btop/btop.conf
t=$HOME/.config/btop/themes/$BTOP.theme; [ -f "$t" ] || t=/usr/share/btop/themes/$BTOP.theme
[ -f "$f" ] && sed -i "s|^color_theme = .*|color_theme = \"$t\"|" "$f"
f=$HOME/.config/Code/User/settings.json
[ -f "$f" ] && sed -i "s|\"workbench.colorTheme\": *\"[^\"]*\"|\"workbench.colorTheme\": \"$VSCODE\"|" "$f"
f=$HOME/.config/zed/settings.json
[ -f "$f" ] && sed -i "/\"theme\": {/,/}/ s|\"dark\": *\"[^\"]*\"|\"dark\": \"$ZED\"|" "$f"
# Spicetify reinicia Spotify: solo si el esquema cambia
if command -v spicetify >/dev/null &&
    ! grep -qE "^color_scheme +=[ ]*$SPICETIFY\$" "$(spicetify -c)"; then
    spicetify config current_theme text color_scheme "$SPICETIFY" >/dev/null &&
        spicetify apply -q >/dev/null || echo "theme: spicetify apply falló (¿falta 'spicetify backup apply'?)" >&2
fi

# Alacritty recarga al cambiar su config
touch "$HOME/.config/alacritty/alacritty.toml"

if [ "${2:-}" = --system ]; then
    LOGIN_WALL=${LOGIN_WALL:-$WALL}
    ext=${LOGIN_WALL##*.}
    # El greeter corre como usuario lightdm y no puede leer ~: lo suyo va a /usr/local/share (no a /usr/share,
    # que es de los paquetes). Excepción: el cursor, porque libXcursor no busca en /usr/local.
    # Iconos: Adwaita (ya en el sistema; copiar los Colloid serían ~54MB para 5 iconos simbólicos casi iguales)
    S=/usr/local/share
    sudo cp -rLT "$HOME/.themes/$GTK" "$S/themes/$GTK"
    sudo cp -rLT "$HOME/.local/share/icons/$CURSOR" "/usr/share/icons/$CURSOR"
    sudo install -Dm644 "$LOGIN_WALL" "$S/backgrounds/dotfiles-login.$ext"
    # Avatar simbólico de Adwaita con el blanco del tema (el greeter lo pinta con el acento)
    sed "s/#2e3436/$FG/" /usr/share/icons/Adwaita/symbolic/status/avatar-default-symbolic.svg |
        sudo tee "$S/backgrounds/dotfiles-avatar.svg" >/dev/null
    # Drop-in: lightdm-gtk-greeter.conf se queda de fábrica. El greeter lee $XDG_CONFIG_DIRS/lightdm/
    # lightdm-gtk-greeter.conf.d/*.conf; lightdm.conf ya lo fija el paquete inspdell-system
    g=/etc/xdg/lightdm/lightdm-gtk-greeter.conf.d
    sudo mkdir -p "$g"
    printf '[greeter]\ntheme-name = %s\nicon-theme-name = Adwaita\ncursor-theme-name = %s\nfont-name = Roboto 11\nbackground = %s\ndefault-user-image = %s\n' \
        "$GTK" "$CURSOR" "$S/backgrounds/dotfiles-login.$ext" "$S/backgrounds/dotfiles-avatar.svg" |
        sudo tee "$g/90-dotfiles.conf" >/dev/null
    echo "login: se ve al cerrar sesión"
fi
echo "tema: $name"
